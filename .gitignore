# Java decompilado con jadx (derivado, regenerable)
/decompiled/
/GloftSOHP/

# Librerías .so propietarias del juego original
lib/*.so
lib/**/*.so
sacredodyssey_extract/lib/

# Assets del juego montados para pruebas
ux0_data/
assets/

# Build artifacts
/build/
CMakeCache.txt
CMakeFiles/
# Anchored to the repo root: an unanchored "Makefile" here would also match
# (and, via the toolkit's build-time rsync --filter=":- .gitignore", strip)
# lib/vitagl/Makefile -- a real, hand-written source file of the vendored
# vitaGL submodule, not a generated artifact.
/Makefile
cmake_install.cmake
*.elf
*.self
*.vpk
*.suprx
*.bin

# Debugging en consola real
/logs/
log_*.txt
*.psp2dmp

# Python
__pycache__/
*.pyc

# Config local del toolkit (contiene IP de tu Vita -- no es secreto pero es de tu red)
.psvita-toolkit.json

